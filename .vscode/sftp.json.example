// ┌──────────────────────────────────────────────────────────────────────┐
// │ 사용법                                                                │
// │  1. 이 파일을 같은 폴더에 `sftp.json` 으로 복사                        │
// │  2. host / username 을 실제 값으로 채움                               │
// │  3. sftp.json 은 .gitignore 에 등록되어 있음 — 커밋되지 않음          │
// │                                                                      │
// │ ⚠️ uploadOnSave 는 false 로 시작한다.                                 │
// │    동기화 테스트가 끝나기 전에 true 로 바꾸면 실서버 스킨을           │
// │    통째로 덮어쓸 수 있다.                                             │
// └──────────────────────────────────────────────────────────────────────┘
{
  "name": "slbs.shop (skin14)",

  "host": "쇼핑몰아이디.cafe24.com",
  "username": "쇼핑몰아이디",
  "protocol": "sftp",
  "port": 22,

  // 비밀번호는 적지 않는다. 연결할 때마다 VS Code 가 물어본다.
  "promptForPassword": true,

  // 원격 스킨 루트. 실제 경로는 접속 후 직접 확인할 것.
  //   /sde_design/skin14  또는  /www/sde_design/skin14  등 계정에 따라 다름
  // 이 경로가 저장소의 layout/ 폴더와 짝이 맞아야 한다.
  //   로컬 layout/basic/navigation.html
  //   → 원격 <remotePath>/layout/basic/navigation.html
  "remotePath": "/sde_design/skin14",

  // 저장 시 자동 업로드 — 동기화 테스트 통과 전까지 반드시 false
  "uploadOnSave": false,

  // 스킨과 무관한 저장소 파일들이 올라가지 않도록 차단
  "ignore": [
    ".git",
    ".gitignore",
    ".vscode",
    "README.md",
    "docs",
    "backup"
  ],

  "watcher": {
    "files": false,
    "autoUpload": false,
    "autoDelete": false
  }
}
